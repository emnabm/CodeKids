    "/children/{id}/stats": {
      "get": {
        "tags": [
          "Children"
        ],
        "summary": "Get parent area stats for a child: completed stages, flames per day (last 7 days), progress per level.\r\nRequires parent PIN token (ParentArea authorization policy).",
        "description": "Protected endpoint. Must supply JWT Bearer token obtained from POST /auth/verify-pin.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
