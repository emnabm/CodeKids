              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/stages/{id}": {
      "get": {
        "tags": [
          "Stages"
        ],
        "summary": "Get stage content, questions, hint texts, and explanation texts.",
        "description": "Rejects locked stages.\r\nReturns options and answer objects formatted cleanly according to the question type schema.\r\nThe Flutter client checks answers locally while server retains anti-cheat authority over rewards and progress.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The Stage GUID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "childId",
            "in": "query",
            "description": "The Child GUID (must belong to authenticated parent)",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StageDetailDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/stages/{id}/hint": {
      "post": {
        "tags": [
          "Stages"
        ],
        "summary": "Purchase a hint for a question within a stage.",
        "description": "Hints cost flames and escalate in price within the same stage for the child:\r\n- 1st hint: 100 flames\r\n- 2nd hint: 150 flames\r\n- 3rd hint: 200 flames (+50 flames each time)\r\n\r\nIf the child does not have sufficient flames, returns 409 Conflict with ProblemDetails.\r\n\r\nSample request:\r\n\r\n    POST /stages/{stageId}/hint\r\n    {\r\n       \"childId\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\r\n       \"questionId\": \"7cb85f64-5717-4562-b3fc-2c963f66afa1\"\r\n    }",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HintRequestDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/HintRequestDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/HintRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HintResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/stages/{id}/complete": {
      "post": {
        "tags": [
          "Stages"
        ],
        "summary": "Mark a stage as completed.",
        "description": "Idempotent (calling twice never doubles flames).\r\nExecuted within a single database transaction (progress, flames, transactions, streak, badges).\r\n\r\nRewards:\r\n- Explanation: 10 flames\r\n- Quiz: 25 flames\r\n- Final: 60 flames\r\n- Streak bonus: +5 flames per consecutive day (capped at +50)\r\n\r\nReplaying a completed stage is allowed for practice but grants 0 flames.\r\n\r\nSample request:\r\n\r\n    POST /stages/{stageId}/complete\r\n    {\r\n       \"childId\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\r\n       \"hintsUsed\": 1,\r\n       \"attempts\": 2\r\n    }",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteStageRequestDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteStageRequestDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteStageRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompleteStageResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
